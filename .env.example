# Copy to .env and fill in real values. Never commit the real .env.
# Locally the API reads this file via pydantic-settings; in Docker and on
# Cloudflare these come from environment variables instead.

# Where in-flight downloads are written (relative = repo root).
# Docker/Cloudflare set this to /tmp/ytdl. Files are deleted after a client fetches them.
DOWNLOAD_DIR=downloads

# JSON list of API keys clients must send in the X-API-Key header.
API_KEYS=["change-me-in-production"]

# Origins allowed to call the API from a browser (native Flutter apps don't need CORS).
CORS_ORIGINS=["http://localhost:3000"]

# YouTube access — free, no cookies, no tokens. The tv_embedded client bypasses
# both the "confirm you're not a bot" gate and the PO-token requirement.
YTDLP_PLAYER_CLIENTS=tv_embedded
# Optional fallbacks if a specific video fails: tv_embedded,android,ios
#
# Escape hatches (usually NOT needed — cookies can REDUCE available formats):
# COOKIES_FROM_BROWSER=chrome        # or safari/brave/firefox/edge
# COOKIE_FILE=/app/cookies.txt       # servers/Docker (no browser)
# YTDLP_PO_TOKEN=web.gvs+XXXX        # only if you force the web client

# Optional tuning
# MAX_CONCURRENT_DOWNLOADS=2
# MAX_FILE_AGE_HOURS=24
# TASK_TTL_SECONDS=3600
# RATE_LIMIT=20/minute
